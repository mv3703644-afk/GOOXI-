{
  "name": "gooxi-v5-2",
  "version": "5.2.0",
  "private": true,
  "scripts": {
    "start": "node server.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}const express = require("express");

const app = express();
const PORT = process.env.PORT || 3000;

app.use(express.json());
app.use(express.static("public"));

app.get("/api/status", (req, res) => {
  res.json({
    online: true,
    name: "GOOXI",
    version: "5.2"
  });
});

app.get("/api/search", (req, res) => {
  const q = String(req.query.q || "").trim();

  if (!q) {
    return res.status(400).json({
      error: "Digite uma pesquisa."
    });
  }

  res.json({
    success: true,
    query: q,
    results: [
      {
        title: `Resultados para ${q}`,
        description: `O GOOXI recebeu sua pesquisa: ${q}`
      },
      {
        title: "GOOXI Imagens",
        description: `Pesquisar imagens de ${q}`
      },
      {
        title: "GOOXI Notícias",
        description: `Pesquisar notícias sobre ${q}`
      }
    ]
  });
});

app.get("/", (req, res) => {
  res.sendFile(__dirname + "/public/index.html");
});

app.use((req, res) => {
  res.status(404).json({
    error: "Página não encontrada."
  });
});

app.listen(PORT, "0.0.0.0", () => {
  console.log("🚀 GOOXI v5.2 online!");
  console.log(`Porta: ${PORT}`);
});
